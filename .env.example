# CalMe backend settings. Copy to .env and fill in; never commit .env.
# Everything is optional except where marked REQUIRED. Unset values use the defaults in app/core/config.py.

# ---------- App ----------
CALME_ENVIRONMENT=development          # production on Render
CALME_DEBUG=true                       # false on Render
CALME_LOG_LEVEL=INFO
# Frontends allowed to call the API (JSON list). Add your Vercel URL in production.
CALME_CORS_ORIGINS=["http://localhost:3000"]
# This API's public https address, no trailing slash. Used for demo cancel links (and Twilio webhooks).
CALME_PUBLIC_BASE_URL=                 # e.g. https://calme-api.onrender.com

# ---------- Database (REQUIRED in production) ----------
# Must start with postgresql+asyncpg://  (Render gives postgresql:// — add +asyncpg)
# Local docker-compose: postgresql+asyncpg://calme:calme@localhost:5433/calme
CALME_DATABASE_URL=

# ---------- Fish Audio (REQUIRED for agents and calls) ----------
CALME_FISH_API_KEY=
CALME_FISH_AGENT_ENABLED=true
CALME_FISH_AGENT_LLM_MODEL=anthropic/claude-haiku-4.5
# Optional: your own OpenAI-compatible LLM instead (public https only)
CALME_FISH_AGENT_LLM_BASE_URL=
CALME_FISH_AGENT_LLM_CUSTOM_MODEL=
CALME_FISH_AGENT_LLM_API_KEY=
CALME_MAX_CALL_SECONDS=900             # also caps each Fish agent call (60–3600)

# ---------- Email: demo bookings (Gmail) ----------
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords),
# not your normal password.
CALME_SMTP_HOST=smtp.gmail.com
CALME_SMTP_PORT=587
CALME_SMTP_USERNAME=                   # your Gmail address
CALME_SMTP_PASSWORD=                   # 16-character app password
CALME_DEMO_INBOX=                      # where bookings go; defaults to CALME_SMTP_USERNAME

# ---------- Landing page demo: talk to Amani ----------
CALME_DEMO_AGENT_ID=                   # the CalMe agent id (UUID) of Amani in this database
CALME_DEMO_SESSIONS_PER_IP_PER_HOUR=3  # each call costs Fish minutes
CALME_DEMO_SESSIONS_PER_HOUR=60

# ---------- Demo calendar: when people can book you ----------
CALME_DEMO_TIMEZONE=Africa/Nairobi
CALME_DEMO_WEEKDAYS=mon,tue,wed,thu,fri
CALME_DEMO_DAY_START=09:00
CALME_DEMO_DAY_END=17:00
CALME_DEMO_SLOT_MINUTES=120
CALME_DEMO_DAYS_AHEAD=14
CALME_DEMO_MIN_NOTICE_HOURS=2

# ---------- Old local pipeline (optional) ----------
# Only the legacy /live websocket, the dashboard chat test and "Improve with AI" use Ollama.
CALME_OLLAMA_BASE_URL=http://localhost:11434
CALME_OLLAMA_MODEL=llama3.2:3b
CALME_IDLE_TIMEOUT_SECONDS=10

# ---------- Twilio (optional, legacy numbers only) ----------
# New numbers are bought through Fish Audio; these only matter for numbers bought from Twilio before.
CALME_TWILIO_ACCOUNT_SID=
CALME_TWILIO_AUTH_TOKEN=
CALME_TWILIO_BUNDLE_SID=
CALME_TWILIO_ADDRESS_SID=
