# CalMe frontend settings. Vite only exposes variables that start with VITE_.
# Copy to .env.local for local overrides; on Vercel set them in Project Settings → Environment Variables.

# Backend address. Leave unset: vercel.json forwards /api/* to the Render backend,
# and in local dev the Vite proxy does the same. Only set it to call the backend directly
# (then the backend's CALME_CORS_ORIGINS must include this site's address).
VITE_API_URL=

# "on" opens the dashboard in production builds. Leave unset to keep it locked.
VITE_DASHBOARD=

# Local dev only (not VITE_, read by vite.config.ts): where the dev proxy sends /api.
CALME_API_URL=http://localhost:8000
